# magic-mirror.env — environment for the Magic Mirror server (Slice 7).
#
# Copy to /etc/magic-mirror/mirror.env and fill in the real values. This file
# holds *secrets and optional overrides only*; the non-secret settings live in
# /etc/magic-mirror/config.toml (see config/mirror.example.toml).
#
# The systemd unit reads this via `EnvironmentFile=-/etc/magic-mirror/mirror.env`.
# Restrict its permissions: `sudo chmod 0640 /etc/magic-mirror/mirror.env` and
# `sudo chown root:mirror /etc/magic-mirror/mirror.env`.
#
# Format: one KEY=VALUE per line. No `export`, no quotes, no `$` expansion.

# --- Secrets (env-only, never in the config file or API JSON) ---------------
# CalDAV app-specific password (Slice 5). Only used when calendar.enabled = true.
MIRROR_CALDAV_APP_PASSWORD=

# BKK FUTÁR API key (Slice 4, from opendata.bkk.hu).
MIRROR_BKK_API_KEY=

# --- Optional overrides (highest precedence; see src/config.rs) -------------
# MIRROR_CONFIG=/etc/magic-mirror/config.toml
# MIRROR_BIND=127.0.0.1:3000
# MIRROR_STATIC_DIR=/usr/share/magic-mirror
# MIRROR_SNAPSHOT_PATH=/var/lib/magic-mirror/snapshot.json
# MIRROR_WEATHER_LAT=47.4979
# MIRROR_WEATHER_LON=19.0402
# MIRROR_WEATHER_REFRESH_SECS=900
# MIRROR_AQI_REFRESH_SECS=3600
# MIRROR_NEWS_REFRESH_SECS=900
# MIRROR_CALENDAR_REFRESH_SECS=300
# Rolling calendar window: 1 = 24h, 2 = 48h, 7 = 168h.
# MIRROR_CALENDAR_LOOKAHEAD_DAYS=7
